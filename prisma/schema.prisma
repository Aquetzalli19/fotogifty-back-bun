generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id                       Int                           @id @default(autoincrement())
  email                    String                        @unique @db.VarChar(255)
  password_hash            String                        @db.VarChar(255)
  nombre                   String                        @db.VarChar(100)
  apellido                 String                        @db.VarChar(100)
  telefono                 String?                       @db.VarChar(20)
  fecha_registro           DateTime                      @default(now())
  activo                   Boolean                       @default(true)
  acepto_terminos          Boolean                       @default(false)
  fecha_ultima_conexion    DateTime?                     @db.DateTime
  token_recuperacion       String?                       @db.VarChar(255)
  fecha_expiracion_token   DateTime?                     @db.DateTime
  cuenta_eliminada         Boolean                       @default(false)
  fecha_eliminacion        DateTime?
  administrador            administradores?
  aceptaciones_terminos    aceptaciones_terminos[]
  direcciones              direcciones[]
  fotos                    fotos[]
  pedidos                  pedidos[]
  stores                   stores?
  carrito_temporal         carritos_temporales?
  customizaciones_temporales customizaciones_temporales[]
  imagenes_temporales      imagenes_temporales[]
}

model direcciones {
  id                  Int       @id @default(autoincrement())
  usuario_id          Int
  alias               String    @db.VarChar(50)
  direccion           String    @db.Text
  ciudad              String    @db.VarChar(100)
  estado              String    @db.VarChar(100)
  codigo_postal       String    @db.VarChar(20)
  pais                String    @default("España") @db.VarChar(100)
  numero_casa         String?   @db.VarChar(50)
  numero_departamento String?   @db.VarChar(50)
  especificaciones    String?   @db.Text
  predeterminada      Boolean   @default(false)
  usuario             usuarios  @relation(fields: [usuario_id], references: [id])
  pedidos             pedidos[]

  @@index([usuario_id], map: "direcciones_usuario_id_fkey")
}

model categorias {
  id             Int                     @id @default(autoincrement())
  nombre         String                  @db.VarChar(100)
  descripcion    String?                 @db.Text
  activo         Boolean                 @default(true)
  fecha_creacion DateTime                @default(now())
  paquetes       paquetes_predefinidos[]
}

model tipo_paquete {
  id          Int                     @id
  nombre      String                  @db.VarChar(50)
  descripcion String?                 @db.Text
  paquetes    paquetes_predefinidos[]
}

model paquetes_predefinidos {
  id               Int            @id @default(autoincrement())
  tipo_paquete_id  Int?
  nombre           String         @db.VarChar(100)
  cantidad_fotos   Int
  precio           Decimal        @db.Decimal(10, 2)
  descripcion      String?        @db.Text
  alto_foto        Decimal        @default(15.00) @db.Decimal(5, 2)
  ancho_foto       Decimal        @default(10.00) @db.Decimal(5, 2)
  categoria_id     Int?
  estado           Boolean        @default(true)
  resolucion_foto  Int            @default(300)
  imagen_url                 String?        @db.VarChar(500)
  template_url               String?        @db.VarChar(500)
  template_key               String?        @db.VarChar(500)
  templates_calendario       Json?
  templates_calendario_keys  Json?
  items_pedido_new      items_pedido[]          @relation("items_pedido_to_paquetes_predefinidos_new")
  items_pedido_old      items_pedido[]          @relation("items_pedido_to_paquetes_predefinidos_old")
  categoria             categorias?             @relation(fields: [categoria_id], references: [id])
  tipo_paquete          tipo_paquete?           @relation(fields: [tipo_paquete_id], references: [id])
  paquete_page_sections paquete_page_sections[]
  paquete_page_slides   paquete_page_slides[]
  paquete_page_options  paquete_page_options[]

  @@index([categoria_id], map: "paquetes_predefinidos_categoria_id_fkey")
  @@index([tipo_paquete_id], map: "paquetes_predefinidos_tipo_paquete_id_fkey")
}

model paquete_page_sections {
  id                   Int                     @id @default(autoincrement())
  paquete_id           Int
  section_key          String                  @db.VarChar(50)
  titulo               String?                 @db.VarChar(255)
  subtitulo            String?                 @db.Text
  descripcion          String?                 @db.Text
  imagen_principal_url String?                 @db.VarChar(500)
  orden                Int                     @default(0)
  activo               Boolean                 @default(true)
  created_at           DateTime                @default(now())
  updated_at           DateTime                @default(now()) @updatedAt
  paquete              paquetes_predefinidos   @relation(fields: [paquete_id], references: [id], onDelete: Cascade)

  @@unique([paquete_id, section_key], map: "uq_paquete_page_sections")
  @@index([paquete_id], map: "idx_paquete_page_sections_paquete")
}

model paquete_page_slides {
  id          Int                    @id @default(autoincrement())
  paquete_id  Int
  section_key String                 @db.VarChar(50)
  tipo        String                 @db.VarChar(30)
  titulo      String?                @db.VarChar(255)
  descripcion String?                @db.Text
  imagen_url  String?                @db.VarChar(500)
  icono       String?                @db.VarChar(50)
  orden       Int                    @default(0)
  activo      Boolean                @default(true)
  created_at  DateTime               @default(now())
  updated_at  DateTime               @default(now()) @updatedAt
  paquete     paquetes_predefinidos  @relation(fields: [paquete_id], references: [id], onDelete: Cascade)
  options     paquete_page_options[]

  @@index([paquete_id, section_key], map: "idx_paquete_page_slides_section")
}

model paquete_page_options {
  id               Int                   @id @default(autoincrement())
  paquete_id       Int
  section_key      String                @db.VarChar(50)
  slide_id         Int?
  texto            String                @db.VarChar(255)
  texto_secundario String?               @db.VarChar(255)
  texto_terciario  String?               @db.VarChar(255)
  texto_cuarto     String?               @db.VarChar(255)
  texto_quinto     String?               @db.VarChar(255)
  orden            Int                   @default(0)
  activo           Boolean               @default(true)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @default(now()) @updatedAt
  paquete          paquetes_predefinidos @relation(fields: [paquete_id], references: [id], onDelete: Cascade)
  slide            paquete_page_slides?  @relation(fields: [slide_id], references: [id], onDelete: Cascade)

  @@index([paquete_id, section_key], map: "idx_paquete_page_options_section")
  @@index([slide_id], map: "idx_paquete_page_options_slide")
}

model estados_pedido {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.Text
  color       String?   @db.VarChar(9)
  orden       Int       @default(0)
  activo      Boolean   @default(true)
  pedidos     pedidos[]
}

model pedidos {
  id                   Int                @id @default(autoincrement())
  usuario_id           Int
  direccion_id         Int?
  estado_id            Int                @default(1)
  fecha_creacion       DateTime           @default(now())
  fecha_actualizacion  DateTime           @default(now())
  total                Decimal            @db.Decimal(10, 2)
  notas                String?            @db.Text
  email_cliente        String             @db.VarChar(255)
  estado_pago          String             @default("pending")
  estado_personalizado String             @default("Pendiente")
  fecha_pedido         DateTime           @default(now())
  id_pago_stripe       String?            @db.VarChar(255)
  id_sesion_stripe     String?            @db.VarChar(255)
  iva                  Decimal            @db.Decimal(10, 2)
  nombre_cliente       String             @db.VarChar(255)
  subtotal             Decimal            @db.Decimal(10, 2)
  telefono_cliente     String?            @db.VarChar(50)
  metodo_entrega       String             @default("envio_domicilio") @db.VarChar(20)
  calendarios          calendario_fotos[]
  fotos                fotos[]
  items                items_pedido[]
  direccion            direcciones?       @relation(fields: [direccion_id], references: [id])
  estado               estados_pedido     @relation(fields: [estado_id], references: [id])
  usuario              usuarios           @relation(fields: [usuario_id], references: [id])

  @@index([direccion_id], map: "pedidos_direccion_id_fkey")
  @@index([estado_id], map: "pedidos_estado_id_fkey")
  @@index([usuario_id], map: "pedidos_usuario_id_fkey")
}

model items_pedido {
  id                     Int                    @id @default(autoincrement())
  pedido_id              Int
  tipo_item              String                 @db.VarChar(20)
  paquete_predefinido_id Int?
  cantidad_fotos         Int
  precio_unitario        Decimal                @db.Decimal(10, 2)
  subtotal               Decimal                @db.Decimal(10, 2)
  cantidad               Int?                   @default(1)
  categoria_paquete      String?                @db.VarChar(100)
  nombre_paquete         String?                @db.VarChar(255)
  num_fotos_requeridas   Int?
  paquete_id             Int?
  calendarios            calendario_fotos[]
  fotos                  fotos[]
  paquete                paquetes_predefinidos? @relation("items_pedido_to_paquetes_predefinidos_new", fields: [paquete_id], references: [id])
  paquete_predefinido    paquetes_predefinidos? @relation("items_pedido_to_paquetes_predefinidos_old", fields: [paquete_predefinido_id], references: [id])
  pedido                 pedidos                @relation(fields: [pedido_id], references: [id])

  @@index([paquete_id], map: "items_pedido_paquete_id_fkey")
  @@index([paquete_predefinido_id], map: "items_pedido_paquete_predefinido_id_fkey")
  @@index([pedido_id], map: "items_pedido_pedido_id_fkey")
}

model fotos {
  id                  Int                @id @default(autoincrement())
  usuario_id          Int
  pedido_id           Int?
  item_pedido_id      Int
  nombre_archivo      String             @db.VarChar(255)
  ruta_almacenamiento String             @db.VarChar(500)
  tamaño_archivo      Int
  ancho_foto          Decimal?           @db.Decimal(5, 2)  // Ancho heredado del paquete
  alto_foto           Decimal?           @db.Decimal(5, 2)   // Alto heredado del paquete
  resolucion_foto     Int?               // Resolución heredada del paquete
  cantidad_copias     Int                @default(1)        // Cantidad de copias físicas a imprimir
  fecha_subida        DateTime           @default(now())
  procesada           Boolean            @default(false)
  calendarios         calendario_fotos[]
  item_pedido         items_pedido       @relation(fields: [item_pedido_id], references: [id])
  pedido              pedidos?           @relation(fields: [pedido_id], references: [id])
  usuario             usuarios           @relation(fields: [usuario_id], references: [id])

  @@index([item_pedido_id], map: "fotos_item_pedido_id_fkey")
  @@index([pedido_id], map: "fotos_pedido_id_fkey")
  @@index([usuario_id], map: "fotos_usuario_id_fkey")
  @@index([item_pedido_id, cantidad_copias], map: "fotos_item_copias_idx")
}

model calendario_fotos {
  id             Int          @id @default(autoincrement())
  pedido_id      Int
  item_pedido_id Int
  mes            Int
  foto_id        Int
  foto           fotos        @relation(fields: [foto_id], references: [id])
  item_pedido    items_pedido @relation(fields: [item_pedido_id], references: [id])
  pedido         pedidos      @relation(fields: [pedido_id], references: [id])

  @@index([foto_id], map: "calendario_fotos_foto_id_fkey")
  @@index([item_pedido_id], map: "calendario_fotos_item_pedido_id_fkey")
  @@index([pedido_id], map: "calendario_fotos_pedido_id_fkey")
}

model administradores {
  id           Int      @id @default(autoincrement())
  usuario_id   Int      @unique
  nivel_acceso Int      @default(1)
  activo       Boolean  @default(true)
  usuario      usuarios @relation(fields: [usuario_id], references: [id])
}

model stores {
  id                 Int      @id @default(autoincrement())
  usuario_id         Int      @unique
  codigo_empleado    String   @unique @db.VarChar(50)
  fecha_contratacion DateTime @default(now())
  activo             Boolean  @default(true)
  usuario            usuarios @relation(fields: [usuario_id], references: [id])
}

enum TipoDocumentoLegal {
  terms
  privacy
}

model documentos_legales {
  id                  Int                      @id @default(autoincrement())
  tipo                TipoDocumentoLegal
  titulo              String                   @db.VarChar(255)
  contenido           String                   @db.Text
  version             String                   @db.VarChar(50)
  activo              Boolean                  @default(false)
  fecha_creacion      DateTime                 @default(now())
  fecha_actualizacion DateTime                 @default(now()) @updatedAt
  aceptaciones        aceptaciones_terminos[]
}

model aceptaciones_terminos {
  id                  Int                 @id @default(autoincrement())
  usuario_id          Int
  documento_legal_id  Int
  version             String              @db.VarChar(50)
  fecha_aceptacion    DateTime            @default(now())
  ip_address          String?             @db.VarChar(45)
  user_agent          String?             @db.Text
  usuario             usuarios            @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  documento_legal     documentos_legales  @relation(fields: [documento_legal_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, documento_legal_id], map: "idx_usuario_documento")
  @@index([usuario_id], map: "aceptaciones_terminos_usuario_id_fkey")
  @@index([documento_legal_id], map: "aceptaciones_terminos_documento_legal_id_fkey")
}

model configuracion_tienda {
  id                      Int       @id @default(autoincrement())
  nombre                  String    @default("FotoGifty") @db.VarChar(255)
  direccion               String    @db.VarChar(500)
  ciudad                  String    @db.VarChar(100)
  estado                  String    @db.VarChar(100)
  codigo_postal           String    @db.VarChar(10)
  pais                    String    @default("México") @db.VarChar(100)
  telefono                String    @db.VarChar(20)
  email                   String?   @db.VarChar(255)
  latitud                 Decimal   @db.Decimal(10, 8)
  longitud                Decimal   @db.Decimal(11, 8)
  horario_lunes_viernes   String?   @db.VarChar(100)
  horario_sabado          String?   @db.VarChar(100)
  horario_domingo         String?   @db.VarChar(100)
  descripcion             String?   @db.Text
  instrucciones_llegada   String?   @db.Text
  direccion_maps          String?   @db.VarChar(500)
  fecha_actualizacion     DateTime  @default(now()) @updatedAt
  actualizado_por         Int?
}

model product_page_sections {
  id                   Int                    @id @default(autoincrement())
  section_key          String                 @unique @db.VarChar(50)
  titulo               String?                @db.VarChar(255)
  subtitulo            String?                @db.Text
  descripcion          String?                @db.Text
  imagen_principal_url String?                @db.VarChar(500)
  orden                Int                    @default(0)
  activo               Boolean                @default(true)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now()) @updatedAt
  slides               product_page_slides[]
  options              product_page_options[]

  @@index([orden], map: "idx_product_page_sections_orden")
}

model product_page_slides {
  id          Int                    @id @default(autoincrement())
  section_key String                 @db.VarChar(50)
  tipo        String                 @db.VarChar(30)
  titulo      String?                @db.VarChar(255)
  descripcion String?                @db.Text
  imagen_url  String?                @db.VarChar(500)
  icono       String?                @db.VarChar(50)
  orden       Int                    @default(0)
  activo      Boolean                @default(true)
  created_at  DateTime               @default(now())
  updated_at  DateTime               @default(now()) @updatedAt
  section     product_page_sections  @relation(fields: [section_key], references: [section_key], onDelete: Cascade)
  options     product_page_options[]

  @@index([section_key], map: "idx_product_page_slides_section")
  @@index([section_key, orden], map: "idx_product_page_slides_section_orden")
}

model product_page_options {
  id               Int                   @id @default(autoincrement())
  section_key      String                @db.VarChar(50)
  slide_id         Int?
  texto            String                @db.VarChar(255)
  texto_secundario String?               @db.VarChar(255)
  texto_terciario  String?               @db.VarChar(255)
  texto_cuarto     String?               @db.VarChar(255)
  texto_quinto     String?               @db.VarChar(255)
  orden            Int                   @default(0)
  activo           Boolean               @default(true)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @default(now()) @updatedAt
  section          product_page_sections @relation(fields: [section_key], references: [section_key], onDelete: Cascade)
  slide            product_page_slides?  @relation(fields: [slide_id], references: [id], onDelete: Cascade)

  @@index([section_key], map: "idx_product_page_options_section")
  @@index([slide_id], map: "idx_product_page_options_slide")
}

model landing_sections {
  id                       Int               @id @default(autoincrement())
  section_key              String            @unique @db.VarChar(50)
  titulo                   String?           @db.VarChar(255)
  subtitulo                String?           @db.Text
  descripcion              String?           @db.Text
  texto_primario           String?           @db.Text
  texto_secundario         String?           @db.Text
  color_primario           String?           @db.VarChar(9)
  color_secundario         String?           @db.VarChar(9)
  color_gradiente_inicio   String?           @db.VarChar(9)
  color_gradiente_medio    String?           @db.VarChar(9)
  color_gradiente_fin      String?           @db.VarChar(9)
  imagen_principal_url     String?           @db.VarChar(500)
  imagen_fondo_url         String?           @db.VarChar(500)
  boton_texto              String?           @db.VarChar(100)
  boton_color              String?           @db.VarChar(9)
  boton_enlace             String?           @db.VarChar(255)
  configuracion_extra      Json?
  orden                    Int               @default(0)
  activo                   Boolean           @default(true)
  created_at               DateTime          @default(now())
  updated_at               DateTime          @default(now()) @updatedAt
  slides                   landing_slides[]
  options                  landing_options[]

  @@index([orden], map: "idx_landing_sections_orden")
}

model landing_slides {
  id          Int               @id @default(autoincrement())
  section_key String            @db.VarChar(50)
  tipo        String            @db.VarChar(30)
  titulo      String?           @db.VarChar(255)
  descripcion String?           @db.Text
  imagen_url  String            @db.VarChar(500)
  orden       Int               @default(0)
  activo      Boolean           @default(true)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @default(now()) @updatedAt
  section     landing_sections  @relation(fields: [section_key], references: [section_key], onDelete: Cascade)

  @@index([section_key], map: "idx_landing_slides_section")
  @@index([section_key, orden], map: "idx_landing_slides_section_orden")
}

model landing_options {
  id          Int               @id @default(autoincrement())
  section_key String            @db.VarChar(50)
  texto       String            @db.VarChar(255)
  orden       Int               @default(0)
  activo      Boolean           @default(true)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @default(now()) @updatedAt
  section     landing_sections  @relation(fields: [section_key], references: [section_key], onDelete: Cascade)

  @@index([section_key], map: "idx_landing_options_section")
  @@index([section_key, orden], map: "idx_landing_options_section_orden")
}

enum EditorType {
  standard
  calendar
  polaroid
}

model carritos_temporales {
  id          Int      @id @default(autoincrement())
  usuario_id  Int      @unique
  datos       Json
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  usuario     usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id], map: "idx_carritos_usuario")
  @@index([updated_at], map: "idx_carritos_updated")
}

model customizaciones_temporales {
  id             Int        @id @default(autoincrement())
  usuario_id     Int
  cart_item_id   String     @db.VarChar(100)
  instance_index Int
  editor_type    EditorType
  datos          Json
  completed      Boolean    @default(false)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @default(now()) @updatedAt
  usuario        usuarios   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, cart_item_id, instance_index], map: "unique_customization")
  @@index([usuario_id], map: "idx_customizaciones_usuario")
  @@index([updated_at], map: "idx_customizaciones_updated")
}

model imagenes_temporales {
  id                Int      @id @default(autoincrement())
  usuario_id        Int
  s3_key            String   @db.VarChar(500)
  s3_url            String?  @db.VarChar(1000)
  original_filename String   @db.VarChar(255)
  mime_type         String   @db.VarChar(100)
  size_bytes        Int
  created_at        DateTime @default(now())
  expires_at        DateTime
  usuario           usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id], map: "idx_imagenes_usuario")
  @@index([expires_at], map: "idx_imagenes_expires")
}

enum PlataformaSocial {
  instagram
  facebook
  whatsapp
  tiktok
  twitter
  youtube
}

model footer_config {
  id            Int            @id @default(autoincrement())
  descripcion   String?        @db.Text
  email         String?        @db.VarChar(255)
  telefono      String?        @db.VarChar(50)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  social_links  social_links[]
}

model social_links {
  id                Int               @id @default(autoincrement())
  footer_config_id  Int
  plataforma        PlataformaSocial
  url               String            @db.VarChar(500)
  orden             Int               @default(0)
  activo            Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @default(now()) @updatedAt
  footer_config     footer_config     @relation(fields: [footer_config_id], references: [id], onDelete: Cascade)

  @@unique([footer_config_id, plataforma], map: "unique_platform")
  @@index([footer_config_id], map: "idx_social_links_footer")
}

model auditoria_eliminaciones {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  timestamp  DateTime @default(now())
  ip         String?  @db.VarChar(45)
  user_agent String?  @db.Text
}
